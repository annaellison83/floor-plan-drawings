ICLOUD_EMAIL=
ICLOUD_APP_PASSWORD=
INTERNAL_ADMIN_TOKEN=
# Shared secret for the Netlify -> Render website intake handoff. Set the
# same random value in Netlify and Render; never commit the value.
RENDER_INTAKE_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_APP_PASSWORD=
MAIL_FROM=FloorPlanDrawings <sender@example.com>
# Optional second SMTP provider used only after bounded primary retries fail.
FALLBACK_SMTP_HOST=
FALLBACK_SMTP_PORT=465
FALLBACK_SMTP_SECURE=true
FALLBACK_SMTP_USER=
FALLBACK_SMTP_APP_PASSWORD=
# Optional address for one alert per failed, logged delivery attempt.
DELIVERY_ALERT_EMAIL=
MAIL_MAX_ATTEMPTS=3
MAIL_RETRY_DELAY_MS=500
# Optional mounted path for Render's canonical project/event/delivery state.
# Without this, state is in-memory and Airtable remains the recovery source.
STATE_FILE=
PROPERTY_RESEARCH_URL=https://floorplandrawings.com/.netlify/functions/property-research
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_JOBS_TABLE=Jobs
AIRTABLE_JOBS_TABLE_ID=
AIRTABLE_COMMUNICATION_LOG_TABLE=Communication Log

# Gmail API intake (separate from Gmail SMTP and the local Codex connector).
# Use a least-privilege OAuth refresh token. Never commit these values or paste
# them into chat. GMAIL_INTAKE_LABEL_ID is the ID for [00] FPD Intake.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_ACCESS_TOKEN=
GMAIL_INTAKE_LABEL_ID=
GMAIL_INTAKE_QUERY=
GMAIL_INTAKE_MAX_RESULTS=25
GMAIL_AGENT_EMAILS=
GMAIL_CLIENT_EMAILS=
GMAIL_PROCESSED_LABEL_ID=
ENABLE_GMAIL_INTAKE_POLL=false
GMAIL_INTAKE_POLL_MS=120000
# Netlify calls this endpoint before using its Airtable fallback.
RENDER_INTAKE_URL=https://floor-plan-drawings.onrender.com/api/intake
QUOTE_APPROVAL_URL=https://floorplandrawings.com/.netlify/functions/approve-quote
PROPOSAL_PUBLIC_BASE_URL=https://floor-plan-drawings.onrender.com/api/scheduling/proposal
PROPOSAL_REVIEW_BASE_URL=https://floor-plan-drawings.onrender.com/api/scheduling/proposal/start
PROPOSAL_SIGNING_SECRET=
APPOINTMENT_PROPOSAL_TTL_HOURS=48
ENABLE_QUOTE_READY_SENDS=false
ENABLE_CLIENT_QUOTE_SENDS=false
ENABLE_PROVISIONAL_HOLDS=false
ENABLE_NEW_REQUEST_SENDS=false
ENABLE_PROPERTY_REVIEW_SENDS=false
ENABLE_FOLLOW_UP_SENDS=false
ENABLE_APPOINTMENT_PROPOSALS=false
# Keep appointment options out of client quote emails until explicitly enabled.
ENABLE_CLIENT_QUOTE_SCHEDULING=false
# Shadow mode reads candidates and renders messages but never writes logs or sends email.
SHADOW_MODE=false
SHADOW_NEW_REQUEST=false
SHADOW_PROPERTY_REVIEW=false
SHADOW_QUOTE_READY=false
SHADOW_CLIENT_QUOTE=false
SHADOW_FOLLOW_UP=false
